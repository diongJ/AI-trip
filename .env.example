# DeepSeek uses Chat Completions for grounded answers and Responses API for web search.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=12

# Optional local semantic retrieval (requires: pip install -e ".[semantic]")
SEMANTIC_RETRIEVAL_ENABLED=true
SEMANTIC_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
SEMANTIC_RERANKER_MODEL=BAAI/bge-reranker-base

# Public demo protection. Set to 0 only for controlled local development.
DEMO_RATE_LIMIT_PER_MINUTE=12

# Neo4j Aura example: neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=replace-with-your-neo4j-uri
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
NEO4J_DATABASE=neo4j
